# NetBandhu — copy to .env and fill in your own keys. Never commit .env.

# Primary: OpenRouter (paid, ~$0.02/M input for gpt-oss-20b)

OPENROUTER_API_KEY=

# Fallback: Gemini free tier. Measured working on this machine; groq returned
# empty content for the same model, which is why Gemini is the fallback here.

GEMINI_API_KEY=

# Optional third provider. Kept because the course uses it and it is free.

GROQ_API_KEY=

# Tracing — free account at smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=netbandhu
